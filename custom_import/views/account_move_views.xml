<odoo>

    <record id="view_move_form_inherit_import" model="ir.ui.view">
        <field name="name">account.move.form.inherit.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="custom_import" string="Custom Import">
                    <group>
                        <field name="custom_import_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_inherit_import" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherit.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="custom_import_id" string="Import Reference" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>