<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_crypto_investment_category" model="ir.module.category">
        <field name="name">Crypto Investment</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_crypto_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_crypto_investment_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_crypto_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_crypto_investment_category"/>
        <field name="implied_ids" eval="[(4, ref('group_crypto_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="crypto_transaction_company_rule" model="ir.rule">
        <field name="name">Crypto Transaction multi-company</field>
        <field name="model_id" ref="model_crypto_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="crypto_beginning_balance_company_rule" model="ir.rule">
        <field name="name">Crypto Beginning Balance multi-company</field>
        <field name="model_id" ref="model_crypto_beginning_balance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
