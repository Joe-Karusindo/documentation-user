<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_crypto_beginning_balance" model="ir.sequence">
        <field name="name">Crypto Beginning Balance</field>
        <field name="code">crypto.beginning.balance</field>
        <field name="prefix">CBB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_crypto_transaction" model="ir.sequence">
        <field name="name">Crypto Transaction</field>
        <field name="code">crypto.transaction</field>
        <field name="prefix">CTX/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_crypto_price_projection" model="ir.sequence">
        <field name="name">Crypto Price Projection</field>
        <field name="code">crypto.price.projection</field>
        <field name="prefix">CPP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
