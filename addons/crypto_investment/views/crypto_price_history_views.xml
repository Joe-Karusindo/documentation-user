<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crypto_price_history_tree" model="ir.ui.view">
        <field name="name">crypto.price.history.tree</field>
        <field name="model">crypto.price.history</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="date"/>
                <field name="asset_id"/>
                <field name="symbol" optional="show"/>
                <field name="price"/>
                <field name="source"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="view_crypto_price_history_form" model="ir.ui.view">
        <field name="name">crypto.price.history.form</field>
        <field name="model">crypto.price.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="date"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="transaction_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crypto_price_history_graph" model="ir.ui.view">
        <field name="name">crypto.price.history.graph</field>
        <field name="model">crypto.price.history</field>
        <field name="arch" type="xml">
            <graph string="Price History" type="line">
                <field name="date"/>
                <field name="price" type="measure"/>
                <field name="asset_id"/>
            </graph>
        </field>
    </record>

    <record id="view_crypto_price_history_search" model="ir.ui.view">
        <field name="name">crypto.price.history.search</field>
        <field name="model">crypto.price.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="symbol"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group expand="0" string="Group By">
                    <filter string="Crypto" name="group_asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crypto_price_history" model="ir.actions.act_window">
        <field name="name">Price History</field>
        <field name="res_model">crypto.price.history</field>
        <field name="view_mode">tree,graph,form</field>
        <field name="context">{'search_default_group_asset': 1}</field>
    </record>
</odoo>
