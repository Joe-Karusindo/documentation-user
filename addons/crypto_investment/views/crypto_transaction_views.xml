<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crypto_transaction_tree" model="ir.ui.view">
        <field name="name">crypto.transaction.tree</field>
        <field name="model">crypto.transaction</field>
        <field name="arch" type="xml">
            <tree decoration-info="transaction_type == 'buy'"
                  decoration-warning="transaction_type == 'beginning'"
                  decoration-success="transaction_type == 'sell' and realized_pnl &gt; 0"
                  decoration-danger="transaction_type == 'sell' and realized_pnl &lt; 0">
                <field name="date"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="symbol" optional="hide"/>
                <field name="transaction_type"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="fee"/>
                <field name="total_amount" sum="Total"/>
                <field name="realized_pnl" sum="Realized P&amp;L"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_crypto_transaction_form" model="ir.ui.view">
        <field name="name">crypto.transaction.form</field>
        <field name="model">crypto.transaction</field>
        <field name="arch" type="xml">
            <form string="Crypto Transaction">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('transaction_type', '=', 'beginning')]}"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            attrs="{'invisible': [('state', '!=', 'done')]}"
                            groups="crypto_investment.group_crypto_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transaction">
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="transaction_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="asset_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="symbol" invisible="1"/>
                            <field name="partner_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="available_qty"
                                      attrs="{'invisible': [('transaction_type', '!=', 'sell')]}"/>
                        </group>
                        <group string="Pricing">
                            <field name="quantity" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="unit_price" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="fee" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="unit_cost"/>
                            <field name="subtotal"/>
                            <field name="total_amount"/>
                            <field name="cost_of_sold"
                                      attrs="{'invisible': [('transaction_type', '!=', 'sell')]}"/>
                            <field name="realized_pnl"
                                      attrs="{'invisible': [('transaction_type', '!=', 'sell')]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Accounting">
                            <field name="journal_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="move_id"/>
                            <field name="beginning_balance_id" readonly="1"
                                      attrs="{'invisible': [('beginning_balance_id', '=', False)]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_crypto_transaction_graph" model="ir.ui.view">
        <field name="name">crypto.transaction.graph</field>
        <field name="model">crypto.transaction</field>
        <field name="arch" type="xml">
            <graph string="Trading Volume" type="bar">
                <field name="date" interval="month"/>
                <field name="transaction_type"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_crypto_transaction_pivot" model="ir.ui.view">
        <field name="name">crypto.transaction.pivot</field>
        <field name="model">crypto.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Trading Analysis">
                <field name="asset_id" type="row"/>
                <field name="transaction_type" type="col"/>
                <field name="total_amount" type="measure"/>
                <field name="realized_pnl" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_crypto_transaction_search" model="ir.ui.view">
        <field name="name">crypto.transaction.search</field>
        <field name="model">crypto.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="symbol"/>
                <field name="partner_id"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Buy" name="buy" domain="[('transaction_type', '=', 'buy')]"/>
                <filter string="Sell" name="sell" domain="[('transaction_type', '=', 'sell')]"/>
                <filter string="Beginning" name="beginning" domain="[('transaction_type', '=', 'beginning')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <group expand="0" string="Group By">
                    <filter string="Crypto" name="group_asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crypto_transaction" model="ir.actions.act_window">
        <field name="name">Buy / Sell</field>
        <field name="res_model">crypto.transaction</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="context">{'search_default_done': 1}</field>
        <field name="domain">[('transaction_type', 'in', ('buy', 'sell'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Catat transaksi beli atau jual crypto
            </p>
        </field>
    </record>

    <record id="action_crypto_transaction_history" model="ir.actions.act_window">
        <field name="name">Transaction History</field>
        <field name="res_model">crypto.transaction</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="context">{'search_default_done': 1, 'search_default_group_asset': 1}</field>
    </record>
</odoo>
