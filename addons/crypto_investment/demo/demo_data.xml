<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Price history for projection samples -->
    <record id="demo_price_btc_1" model="crypto.price.history">
        <field name="asset_id" ref="crypto_asset_btc"/>
        <field name="date" eval="(DateTime.today() - relativedelta(days=20)).strftime('%Y-%m-%d')"/>
        <field name="price">62000.0</field>
        <field name="source">manual</field>
    </record>
    <record id="demo_price_btc_2" model="crypto.price.history">
        <field name="asset_id" ref="crypto_asset_btc"/>
